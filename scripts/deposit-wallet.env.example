# 复制本文件为 scripts/.env 再填值。scripts/.env 已被 .gitignore 忽略,绝不要提交。
# 运行: node --env-file=scripts/.env scripts/test-deposit-wallet.mjs

# 必填:从 https://reveal.magic.link/polymarket 导出的私钥(0x 开头)。仅本机使用!
PRIVATE_KEY=0x

# funder = 个人资料页「仅供 API 使用、请勿发送资金」的地址(= V2 交易代理 / deposit wallet)
FUNDER=0x4CFd6C92566969FFEb94bc8636c3779AcC0A2dED

# relayer 密钥页面的 RELAYER_API_KEY_ADDRESS,仅用于核对它是否 == 私钥派生的 EOA
EXPECTED_EOA=0x4745a326D20bfE33E5e119713ce49B4343055f6a

# 默认即可
CLOB_API_URL=https://clob.polymarket.com
RPC_URL=https://polygon-bor-rpc.publicnode.com
CHAIN_ID=137

# 可选:若已有 CLOB 凭据可填,脚本会跳过 createOrDeriveApiKey
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASS_PHRASE=

# 可选 Phase 4(端到端挂单+撤单)。⚠ 实测请直连家庭网络,关掉 v2raya 代理。
PLACE_ORDER=false
# TOKEN_ID=
ORDER_SIDE=BUY
ORDER_PRICE=0.02
ORDER_SIZE=5
